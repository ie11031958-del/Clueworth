{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clueworth-nonsense",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}